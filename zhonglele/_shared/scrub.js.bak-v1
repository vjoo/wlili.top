/* ============================================
   Zhonglele Home — Scroll-Scrub 渲染器与滚动引擎
   ─────────────────────────────────────────
   数据驱动：读同目录 content.json 的 home 节点，渲染「单视频 + sticky + 滚动驱动进度」首页。
   纯静态可跑（不依赖 /api 后端），本地与线上托管一致。

   ⚠️ 几何契约与 scrub.css 文件头严格对齐，改一处必须同步另一处：
        stage 高 = sticky(1屏) + spacer(N−1屏) = N 屏         ← JS 只设 spacer
        粘滞距离 = stage高 − 1屏 = (N−1) × vh = 场景间隔总高   ← 相邻两屏之间正好 1 屏滚动
        p = (scrollY − stageTop) / ((N−1) × vh)  →  视频 0..duration
        场景 i（下标 0 起）在 p = i/(N−1) 时正好铺满视口；
        滚动终点 p=1 那一刻，**最后一个场景**正好铺满视口、视频也正好播完，
        再往下滚 footer 立刻顶上来 —— 舞台末尾不留任何「没有文字内容的屏幕」。
        （N=1 时无滚动距离，单屏直接接 footer。）
   ⚠️ 视口高度只有一个来源：--zl-vh（JS 注入 innerHeight px）。CSS 里不要再写 100vh 做布局高度。
   ⚠️ 文字浮现由 rAF 逐帧写内联 opacity/transform 驱动，CSS 侧禁止给 .zl-copy 加 transition。
   ⚠️ 后台「画面预览」是监视器（不是整页 iframe）：admin 直接调用本文件导出的场景渲染
        函数 buildScene()，并加载同一份 scrub.css —— 前台与后台共用同一份渲染代码与样式，
        所以观感天然一致，不存在「后台另写一套预览逻辑」的漂移风险。
        （历史：早期用 iframe 加载 index.html?preview=1 + postMessage 推数据，会把整站
         含头部/底部一起塞进预览框，信息密度低又没法看单帧，已废弃。）
   ============================================ */
(function () {
  'use strict';

  // =========================================
  // 字体：唯一数据源是 _shared/fonts.js（window.ZL_FONTS / ZL_FONT_UTIL）。
  // ⚠️ 本文件不再内置字体清单 —— 前后台各存一份必然漂移，加字体只改 fonts.js。
  //    fonts.js 必须在本脚本之前引入；缺失时降级为「不注入外部字体、只用系统栈」。
  // =========================================
  var FONT_UTIL = window.ZL_FONT_UTIL || {
    ensureFont: function () {},
    stack: function () { return ''; }
  };
  function ensureFont(key) { FONT_UTIL.ensureFont(key); }
  function fontStack(key) { return FONT_UTIL.stack(key); }

  // =========================================
  // 默认内容（content.json 缺字段时的兜底，与后台表单默认值同源）
  // =========================================
  var DEFAULT_TYPO = {
    fontFamily: 'system',
    titleSize: 60,        // 桌面基准 px（clamp 上限）
    titleWeight: 900,
    titleLineHeight: 1.18,
    titleSpacing: 0.01,   // em
    subSize: 18,
    numSize: 13,
    copyMax: 680,         // 文案块最大宽度 px
    align: 'left',        // left | center | right
    vAlign: 'bottom',     // top | center | bottom
    accent: '#4d7cfe',
    ink: '',              // 空 = 跟随主题
    inkSoft: ''
  };

  var DEFAULT_HOME = {
    video: { src: '', poster: '', duration: 0 },
    loop: { enabled: true, start: 0, end: 1.6, zone: 0.5 },
    fade: { pos: 'bottom', height: 46, scrim: 0.35 },
    dots: true,
    smoothing: 0.18,      // 滚动阻尼：0=raw 直接跟随滚轮，1=极平滑；建议 0.12~0.25
    typography: DEFAULT_TYPO,
    scenes: []
  };

  // 字号基准断点：宽度 ≥ 该值时 clamp 取桌面基准值，窄屏按等效 vw 收缩
  var TYPE_BASE_W = 1280;

  // ⚠️ 舞台末尾**不留任何"独立收束屏"** —— 两条历史教训，别再往回改：
  //    ① 曾经在场景之后多留 0.5 / 1 屏"余量"（视频冻结、只有背景色），
  //       用户滚过去看到的就是「视频播完下面空出一大截」；
  //    ② 后来改成用一屏"尾声屏"（"故事还在继续"）去填满那 1 屏，虽然不空了，
  //       但仍然是"视频播完后再多滚一屏"—— 用户明确表示这一屏不要。
  //    现在的做法：滚动距离 = (N−1) 屏，即**只保留场景之间的间隔**，
  //    最后一个场景铺满视口的同一刻视频播完，紧接着就是 footer，零余量零空档。
  //    代价：视频总时长摊在 (N−1) 屏上，比原来略快 —— 这是"不要收束屏"的必然结果。

  function num(v, d) {
    var n = parseFloat(v);
    return isFinite(n) ? n : d;
  }
  function clamp(v, lo, hi) { return v < lo ? lo : (v > hi ? hi : v); }
  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  // 多行文本 → <br>（后台文本域换行原样呈现）
  function escMultiline(s) {
    return esc(s).replace(/\r?\n/g, '<br>');
  }

  // 合并排版：场景级字段为空/0 时继承全局 typography，全局缺失再回退 DEFAULT_TYPO
  function mergeTypo(global, scene) {
    var g = Object.assign({}, DEFAULT_TYPO, global || {});
    var s = scene || {};
    var out = {};
    Object.keys(DEFAULT_TYPO).forEach(function (k) {
      var v = s[k];
      var isEmpty = (v === undefined || v === null || v === '' ||
                     (typeof v === 'number' && v === 0) ||
                     (typeof v === 'string' && v.trim() === ''));
      out[k] = isEmpty ? g[k] : v;
    });
    return out;
  }

  // 把排版参数编译成 CSS 自定义属性字符串（供 style 属性内联）
  function typoVars(t) {
    var parts = [];
    var titleSize = num(t.titleSize, 60);
    var subSize = num(t.subSize, 18);
    var numSize = num(t.numSize, 13);
    // clamp 三段：下限 px / 等效 vw（基准宽度处正好等于基准值）/ 桌面基准 px
    parts.push('--zl-title-size:' + titleSize + 'px');
    parts.push('--zl-title-vw:' + (titleSize / TYPE_BASE_W * 100).toFixed(3) + 'vw');
    parts.push('--zl-title-min:' + Math.max(22, Math.round(titleSize * 0.45)) + 'px');
    parts.push('--zl-title-weight:' + num(t.titleWeight, 900));
    parts.push('--zl-title-lh:' + num(t.titleLineHeight, 1.18));
    parts.push('--zl-title-ls:' + num(t.titleSpacing, 0.01) + 'em');
    parts.push('--zl-sub-size:' + subSize + 'px');
    parts.push('--zl-sub-vw:' + (subSize / TYPE_BASE_W * 100).toFixed(3) + 'vw');
    parts.push('--zl-sub-min:' + Math.max(12, Math.round(subSize * 0.72)) + 'px');
    parts.push('--zl-num-size:' + numSize + 'px');
    parts.push('--zl-num-vw:' + (numSize / TYPE_BASE_W * 100).toFixed(3) + 'vw');
    parts.push('--zl-num-min:' + Math.max(10, Math.round(numSize * 0.82)) + 'px');
    parts.push('--zl-copy-max:' + num(t.copyMax, 680) + 'px');
    if (t.accent) parts.push('--zl-scene-accent:' + t.accent);
    if (t.ink) parts.push('--zl-scene-ink:' + t.ink);
    if (t.inkSoft) parts.push('--zl-scene-soft:' + t.inkSoft);
    var stack = fontStack(t.fontFamily);
    if (stack) parts.push('--zl-scene-font:' + stack);
    return parts.join(';');
  }

  // =========================================
  // 渲染
  // =========================================
  var state = {
    home: null,
    scenes: [],       // 归一化后的场景（含 tStart/tEnd）
    n: 0,
    vh: 0,
    stageTop: 0,
    span: 0,          // 粘滞距离 = (n-1) * vh
    spanScreens: 0,   // 场景间隔数 = max(0, n-1)，文字/圆点的进度分母
    duration: 0,
    lastT: -1,
    smoothP: 0,       // 阻尼后的滚动进度（文字与视频共用）
    reduce: false,
    ticking: false,
    rafId: 0,
    loopRaf: 0
  };

  var els = {};

  function getVh() {
    return window.innerHeight || document.documentElement.clientHeight || 800;
  }

  // 归一化场景：补齐 tStart/tEnd，保证 tEnd ≥ tStart
  function normalizeScenes(home) {
    var list = Array.isArray(home.scenes) ? home.scenes : [];
    return list.map(function (s, i) {
      var a = Math.max(0, num(s.tStart, 0));
      var b = Math.max(a, num(s.tEnd, a));
      return Object.assign({}, s, { tStart: a, tEnd: b, _i: i });
    });
  }

  /**
   * 单屏文案层。**前台渲染与后台预览共用本函数**（后台另导出为 ZLHome.buildScene）：
   * 后台监视器把它的输出塞进一个 1280×800 的逻辑视口，就得到与前台一致的画面。
   * @param {object} s          场景数据
   * @param {number} i          场景下标（决定「第 N 屏」兜底文案与首屏提示线）
   * @param {object} globalTypo 全局排版（mergeTypo 会自动补 DEFAULT_TYPO）
   */
  function sceneHtml(s, i, globalTypo) {
    var t = mergeTypo(globalTypo, s);
    ensureFont(t.fontFamily);
    var vars = typoVars(t);
    var cta = '';
    if (s.ctaText && s.ctaHref) {
      var blank = s.ctaBlank ? ' target="_blank" rel="noopener"' : '';
      cta = '<a class="zl-cta" href="' + esc(s.ctaHref) + '"' + blank + '>' + esc(s.ctaText) + '</a>';
    }
    var hint = (i === 0 && s.showHint !== false)
      ? '<div class="zl-hint" aria-hidden="true"><span class="zl-hint-line"></span></div>' : '';
    var label = s.num ? esc(s.num).replace(/<[^>]*>/g, '') : ('第 ' + (i + 1) + ' 屏');
    return '<section class="zl-scene" data-i="' + i + '"' +
             ' data-h="' + esc(t.align) + '" data-v="' + esc(t.vAlign) + '"' +
             ' style="' + esc(vars) + '"' +
             ' aria-label="' + esc(label) + '">' +
             '<div class="zl-copy">' +
               (s.num ? '<p class="zl-num">' + escMultiline(s.num) + '</p>' : '') +
               (s.title ? '<h2 class="zl-title">' + escMultiline(s.title) + '</h2>' : '') +
               (s.sub ? '<p class="zl-sub">' + escMultiline(s.sub) + '</p>' : '') +
               cta +
             '</div>' + hint +
           '</section>';
  }

  function dotsHtml(scenes) {
    return scenes.map(function (s, i) {
      var label = s.num || s.title || ('第 ' + (i + 1) + ' 屏');
      return '<button class="zl-dot' + (i === 0 ? ' is-active' : '') + '" type="button"' +
             ' data-target="' + i + '" aria-label="' + esc(label) + '"><i></i></button>';
    }).join('');
  }

  function emptyStateHtml() {
    return '<div class="zl-empty">' +
             '<strong>还没有配置首页视频</strong>' +
             '<span>打开后台「首页编辑」上传视频并添加场景</span>' +
           '</div>';
  }

  /**
   * 渲染整个首页舞台。初始渲染与后台预览的参数变更**共用本函数**，
   * 保证「所见即所得」不会因为两套代码而走偏。
   */
  function render(content) {
    var host = document.getElementById('zl-home');
    if (!host) return;

    // scroll-scrub 必须让 wheel/trackpad 直接驱动 scrollY，禁用浏览器 CSS 平滑滚动。
    // 否则滚轮一甩，浏览器会对 scrollY 做插值，手指离开后视频仍被拖动，手感失控。
    document.documentElement.style.scrollBehavior = 'auto';
    if (document.body) document.body.style.scrollBehavior = 'auto';

    var home = Object.assign({}, DEFAULT_HOME, (content && content.home) || {});
    home.video = Object.assign({}, DEFAULT_HOME.video, home.video || {});
    home.loop = Object.assign({}, DEFAULT_HOME.loop, home.loop || {});
    home.fade = Object.assign({}, DEFAULT_HOME.fade, home.fade || {});
    home.typography = Object.assign({}, DEFAULT_TYPO, home.typography || {});

    var scenes = normalizeScenes(home);
    state.home = home;
    state.scenes = scenes;
    state.n = scenes.length;
    state.reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 全局强调色提升到 :root，让圆点导航/提示线也跟着走
    if (home.typography.accent) {
      document.documentElement.style.setProperty('--zl-accent', home.typography.accent);
    }

    var hasVideo = !!home.video.src;
    var fadeH = clamp(num(home.fade.height, 46), 0, 100);
    var videoTag = hasVideo
      ? '<video class="zl-video" id="zlVideo" muted playsinline preload="auto" tabindex="-1"' +
        (home.video.poster ? ' poster="' + esc(home.video.poster) + '"' : '') +
        ' src="' + esc(home.video.src) + '"></video>'
      : '';

    // 复用已有 video 元素：后台预览每敲一个字都会 render()，若每次都重建 <video>，
    // 视频会反复重新下载解码、画面不停闪。src 未变时把旧元素搬回来，保住 currentTime 与缓冲。
    // （innerHTML 只是把它从 DOM 摘掉，JS 引用仍持有存活的元素）
    var oldVideo = els.video;
    var reuseVideo = !!(oldVideo && hasVideo && oldVideo.getAttribute('src') === home.video.src);

    // 舞台 = sticky 视频层(1 屏) + spacer(N−1 屏)，总高恰好 N 屏；
    // 场景层绝对定位覆盖这 N 屏，script 末尾就是 footer —— 没有独立的收束屏（见文件头契约）。
    host.innerHTML =
      '<div class="zl-stage" id="zlStage">' +
        '<div class="zl-sticky" id="zlSticky">' +
          videoTag +
          '<div class="zl-fade" data-pos="' + esc(home.fade.pos || 'bottom') + '"' +
            ' style="height:' + fadeH + 'vh;--zl-scrim:' + clamp(num(home.fade.scrim, 0.35), 0, 1) + '"' +
            ' aria-hidden="true"></div>' +
          (hasVideo ? '' : emptyStateHtml()) +
        '</div>' +
        '<div class="zl-spacer" id="zlSpacer"></div>' +
        '<div class="zl-scenes" id="zlScenes">' +
          scenes.map(function (s, i) { return sceneHtml(s, i, home.typography); }).join('') +
        '</div>' +
      '</div>';

    if (reuseVideo) {
      var fresh = host.querySelector('#zlVideo');
      if (fresh && fresh.parentNode) {
        if (home.video.poster) oldVideo.setAttribute('poster', home.video.poster);
        else oldVideo.removeAttribute('poster');
        fresh.parentNode.replaceChild(oldVideo, fresh);
      }
    }

    // 圆点导航挂到 body（fixed 定位，避免被 stage 的层叠上下文困住）
    var oldDots = document.getElementById('zlDots');
    if (oldDots) oldDots.remove();
    if (home.dots !== false && state.n > 1) {
      var nav = document.createElement('nav');
      nav.className = 'zl-dots';
      nav.id = 'zlDots';
      nav.setAttribute('aria-label', '章节导航');
      nav.innerHTML = dotsHtml(scenes);
      document.body.appendChild(nav);
    }

    els.stage = document.getElementById('zlStage');
    els.sticky = document.getElementById('zlSticky');
    els.video = document.getElementById('zlVideo');
    els.spacer = document.getElementById('zlSpacer');
    els.scenes = document.getElementById('zlScenes');
    els.dots = document.getElementById('zlDots');
    els.copies = Array.prototype.slice.call(host.querySelectorAll('.zl-copy'));

    bindDots();
    measure();
    // 初始化阻尼进度为当前真实滚动位置，避免从 0 开始慢慢追
    var y0 = window.scrollY || document.documentElement.scrollTop || 0;
    state.smoothP = state.span > 0 ? clamp((y0 - state.stageTop) / state.span, 0, 1) : 0;
    initVideo(reuseVideo);
    update(true);
  }

  // =========================================
  // 几何测量：--zl-vh / --zl-nav-h / spacer 高度 / stageTop
  // =========================================
  var lastVw = 0;
  function measure() {
    var vh = getVh();
    var vw = window.innerWidth;
    // 移动端地址栏伸缩会让 innerHeight 反复变化，只有宽度变化或高度变化明显才重设，
    // 否则滚动中不断改布局高度会造成跳动。
    if (!state.vh || vw !== lastVw || Math.abs(vh - state.vh) > 100) {
      state.vh = vh;
      lastVw = vw;
      document.documentElement.style.setProperty('--zl-vh', vh + 'px');
    }
    var header = document.querySelector('.header-overlay .header-content') ||
                 document.querySelector('.header-overlay');
    if (header) {
      var h = Math.round(header.getBoundingClientRect().height) || 96;
      document.documentElement.style.setProperty('--zl-nav-h', h + 'px');
    }
    // spacer 撑出「相邻两屏之间的间隔」，共 (N−1) 屏；stage 自然高 = sticky(1 屏) + spacer = N 屏，
    // 与场景层总高（N 屏）严格相等。粘滞距离 = stage高 − 1 屏 = (N−1) 屏：
    // 最后一个场景铺满视口的同一刻视频也播完，紧接着就是 footer，
    // 中间没有任何「没有文字内容的屏幕」（见文件头契约）。N=1 时无滚动距离。
    var spanScreens = Math.max(0, state.n - 1);
    var spacerPx = spanScreens * state.vh;
    state.spanScreens = spanScreens;
    if (els.spacer) els.spacer.style.height = spacerPx + 'px';
    if (els.stage) {
      var y = window.scrollY || document.documentElement.scrollTop || 0;
      state.stageTop = els.stage.getBoundingClientRect().top + y;
    }
    state.span = spacerPx;
  }

  // =========================================
  // 视频：元信息就绪后校准时长；首屏自动循环
  // =========================================
  // 后台可能配了超出实际时长的 tEnd（换了更短的视频等），统一收敛，
  // 否则 seek 到无效位置浏览器会静默卡在最后一帧。
  function clampScenesToDuration() {
    state.scenes.forEach(function (s) {
      s.tStart = clamp(s.tStart, 0, state.duration);
      s.tEnd = clamp(s.tEnd, s.tStart, state.duration);
    });
  }

  /**
   * @param {boolean} reused 复用的是上一次 render 的同一个 <video> 元素。
   *   此时事件已绑过、数据已缓冲 —— 必须跳过重复绑定与 load()，否则每次预览刷新都
   *   会叠加一层监听并把播放位置重置。
   */
  function initVideo(reused) {
    var v = els.video;
    if (!v) return;

    if (reused) {
      // 只做与新数据相关的收敛：时长 clamp + 循环看守重启
      if (state.duration > 0) clampScenesToDuration();
      stopLoopWatcher();
      startLoopWatcher();
      return;
    }

    if (els.sticky) els.sticky.classList.add('is-loading');

    function onMeta() {
      state.duration = isFinite(v.duration) ? v.duration : 0;
      if (els.sticky) els.sticky.classList.remove('is-loading');
      if (state.duration > 0) clampScenesToDuration();
      update(true);
      try {
        window.dispatchEvent(new CustomEvent('zl-video-ready', {
          detail: { duration: state.duration }
        }));
      } catch (_) {}
    }
    if (v.readyState >= 1) onMeta();
    else v.addEventListener('loadedmetadata', onMeta, { once: true });

    v.addEventListener('canplay', function () {
      if (els.sticky) els.sticky.classList.remove('is-loading');
      if (state.lastT < 0) {
        state.lastT = state.scenes.length ? state.scenes[0].tStart : 0;
        try { v.currentTime = state.lastT; } catch (_) {}
      }
      update();
    });
    v.addEventListener('error', function () {
      if (els.sticky) els.sticky.classList.remove('is-loading');
    });
    v.load();

    startLoopWatcher();
  }

  // 首屏自动循环：未下滑时循环播放开场片段，让页面保持动态。
  // 逐帧检查比 timeupdate 精确（timeupdate 约 250ms 一次，会冲出循环终点）。
  function isAutoplayZone() {
    var home = state.home;
    if (!home || home.loop.enabled === false) return false;
    var y = window.scrollY || document.documentElement.scrollTop || 0;
    return y < state.vh * clamp(num(home.loop.zone, 0.85), 0.05, 1);
  }

  function stopLoopWatcher() {
    if (state.loopRaf) {
      cancelAnimationFrame(state.loopRaf);
      state.loopRaf = 0;
    }
  }

  function startLoopWatcher() {
    stopLoopWatcher();
    if (state.reduce) return;
    var tick = function () {
      var v = els.video;
      var home = state.home;
      if (v && home && !document.hidden && isAutoplayZone()) {
        var a = clamp(num(home.loop.start, 0), 0, 1e6);
        var b = num(home.loop.end, a + 1.6);
        if (state.duration > 0) {
          a = clamp(a, 0, state.duration);
          b = clamp(b, a + 0.05, state.duration);
        }
        if (v.currentTime >= b || v.currentTime < a - 0.05) {
          try { v.currentTime = a; } catch (_) {}
        }
      }
      state.loopRaf = requestAnimationFrame(tick);
    };
    state.loopRaf = requestAnimationFrame(tick);
  }

  // 页面隐藏时暂停视频与循环 rAF，回到前台再恢复（省电，也避免后台跑空转）
  document.addEventListener('visibilitychange', function () {
    var v = els.video;
    if (document.hidden) {
      stopLoopWatcher();
      if (v && !v.paused) { try { v.pause(); } catch (_) {} }
    } else {
      startLoopWatcher();
      update(true);
    }
  }, false);

  // =========================================
  // 滚动驱动主循环
  // =========================================
  // 场景局部进度 lp：-1 = 刚从视口下方进入，0 = 正好满屏，1 = 完全滚出顶部
  function sceneAlpha(lp) {
    if (lp <= -0.9 || lp >= 1) return 0;
    if (lp < -0.25) return (lp + 0.9) / 0.65;   // 淡入
    if (lp <= 0.35) return 1;                    // 稳定全显
    return Math.max(0, (1 - lp) / 0.65);         // 淡出
  }

  function update(force) {
    var n = state.n;
    if (!n) return;
    var y = window.scrollY || document.documentElement.scrollTop || 0;
    var rawP = state.span > 0 ? clamp((y - state.stageTop) / state.span, 0, 1) : 0;
    var home = state.home || {};

    // ---- 滚动阻尼：rawP 来自原生 scroll，smoothP 是它的一阶滞后 ----
    // 作用：触控板/高精度滚轮甩一下时，画面不会硬生生被拖到目标位置，
    // 而是带缓冲地追上来，力度更好控制。减弱动效时关闭阻尼（factor=1）。
    var smoothing = state.reduce ? 1 : clamp(num(home.smoothing, 0.18), 0, 1);
    if (force || !isFinite(state.smoothP) || smoothing <= 0) {
      state.smoothP = rawP;
    } else {
      state.smoothP += (rawP - state.smoothP) * smoothing;
      if (Math.abs(rawP - state.smoothP) < 0.0003) state.smoothP = rawP;
    }
    var p = state.smoothP;

    // ---- 1. 文字浮现（逐帧内联，不依赖 CSS transition） ----
    // 场景 i 满屏于 p = i / spanScreens（相邻两屏之间正好 1 屏滚动，与旧版节奏一致）
    var ss = state.spanScreens;
    for (var i = 0; i < els.copies.length; i++) {
      var lp = p * ss - i;
      var a = state.reduce ? 1 : sceneAlpha(lp);
      var ty = (!state.reduce && a < 1 && lp < 0) ? (1 - a) * 28 : 0;
      var c = els.copies[i];
      c.style.opacity = a.toFixed(3);
      c.style.transform = ty ? ('translate3d(0,' + ty.toFixed(1) + 'px,0)') : 'translate3d(0,0,0)';
      c.style.visibility = a <= 0.001 ? 'hidden' : 'visible';
    }

    // ---- 2. 视频进度 ----
    var v = els.video;
    if (v) {
      if (state.reduce) {
        // 减弱动效：不做 scrub，停在首段起点即可
        if (!v.paused) { try { v.pause(); } catch (_) {} }
        if (state.lastT < 0 && v.readyState >= 1) {
          state.lastT = state.scenes[0].tStart;
          try { v.currentTime = state.lastT; } catch (_) {}
        }
      } else if (isAutoplayZone()) {
        // 首屏区间：自动循环播放（循环边界由 loopWatcher 负责）
        if (v.readyState >= 2 && v.paused && !document.hidden) {
          v.play().catch(function () { /* 自动播放被拦截时静默 */ });
        }
      } else {
        // 下滑后：暂停自动播放，改由滚动位置驱动进度
        if (!v.paused) { try { v.pause(); } catch (_) {} }
        // 整段视频 0..duration 映射到 p∈[0,1]（p=1 时正好停在末段终点）。
        // 段边界在 p=i/N，而场景满屏在 p=i/(N−1)：首末两屏严格对齐，中间屏近似对齐。
        // 滚动距离比"带收束屏"的旧版少 1 屏 ⇒ 同一段视频在更短的距离里播完、整体略快，
        // 这是去掉收束屏的必然结果；想更慢只能加场景（多一屏就多一段滚动距离）。
        var segPos = p * n;
        var seg = Math.min(Math.floor(segPos), n - 1);
        var lpSeg = segPos - seg;
        var sc = state.scenes[seg];
        var t = sc.tStart + lpSeg * (sc.tEnd - sc.tStart);
        // 变化超过阈值才 seek：过密的 seek 会让解码器抖动
        if ((force || Math.abs(t - state.lastT) > 0.03) && v.readyState >= 2) {
          state.lastT = t;
          try { v.currentTime = t; } catch (_) {}
        }
      }
    }

    // ---- 3. 圆点激活态 + 舞台结束后隐藏 ----
    if (els.dots) {
      var active = clamp(Math.round(p * state.spanScreens - 0.001), 0, n - 1);
      var btns = els.dots.children;
      for (var k = 0; k < btns.length; k++) {
        btns[k].classList.toggle('is-active', k === active);
      }
      // 滚到滚动终点（y = stageTop + span，即最后一个场景铺满视口、footer 即将露头）就收起圆点：
      // 舞台到此结束，章节导航没有意义了。淡出有 0.35s 过渡（见 scrub.css）。
      var past = y >= state.stageTop + state.span;
      els.dots.classList.toggle('is-hidden', past);
    }

    // 阻尼未收敛时继续保持 rAF，否则停止滚动后 smoothP 永远追不上 rawP
    var stillMoving = !force && smoothing > 0 && Math.abs(rawP - state.smoothP) > 0.0003;
    if (stillMoving) {
      state.rafId = requestAnimationFrame(function () { update(); });
    } else {
      state.ticking = false;
    }
  }

  function onScroll() {
    if (state.ticking) return;
    state.ticking = true;
    state.rafId = requestAnimationFrame(function () { update(); });
  }

  function bindDots() {
    if (!els.dots) return;
    Array.prototype.forEach.call(els.dots.querySelectorAll('.zl-dot'), function (btn) {
      btn.addEventListener('click', function () {
        var i = parseInt(btn.getAttribute('data-target'), 10) || 0;
        scrollToScene(i);
      });
    });
  }

  function scrollToScene(i) {
    measure();
    // 场景 i 满屏于 p = i / spanScreens（不是 i/n —— 滚动距离只有 (N−1) 屏）
    var targetP = state.spanScreens > 0 ? clamp(i / state.spanScreens, 0, 1) : 0;
    var target = state.stageTop + targetP * state.span;
    if (window.SiteShell && typeof window.SiteShell.smoothScrollTo === 'function') {
      window.SiteShell.smoothScrollTo(target, 700);
    } else {
      window.scrollTo({ top: target, behavior: state.reduce ? 'auto' : 'smooth' });
    }
    // 圆点导航属于「明确跳转」，阻尼进度直接 snap 到目标，不要让它慢慢滑翔
    state.smoothP = targetP;
  }

  // =========================================
  // 启动
  // =========================================
  var resizeTick = false;
  function onResize() {
    if (resizeTick) return;
    resizeTick = true;
    requestAnimationFrame(function () {
      measure();
      update(true);
      resizeTick = false;
    });
  }

  function bindGlobal() {
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
    window.addEventListener('orientationchange', onResize);
    // 图片/字体异步到达可能改变 header 高度 → 重新测量一次
    if (document.fonts && document.fonts.addEventListener) {
      document.fonts.addEventListener('loadingdone', onResize);
    }
    window.addEventListener('load', onResize);
  }

  function loadContent() {
    return fetch('content.json', { cache: 'no-store' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) { return d || {}; })
      .catch(function () { return {}; });
  }

  function boot() {
    // 后台 admin.html 也会引入本脚本，只为复用 DEFAULT_TYPO / DEFAULT_HOME 与 buildScene()。
    // 没有舞台容器就完全不启动（不绑事件、不拉 content.json），保证零副作用。
    if (!document.getElementById('zl-home')) return;

    bindGlobal();

    loadContent().then(function (content) {
      window.ZL_CONTENT = content;
      render(content);
      // 把导航 / 底部 Let's talk 配置派给外壳脚本
      try {
        window.dispatchEvent(new CustomEvent('zl-content-loaded', { detail: content }));
      } catch (_) {}
      if (content.site && content.site.title) document.title = content.site.title;
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }

  // 暴露给后台（admin.html 复用默认值与场景渲染，避免两处各写一份；字体表见 fonts.js）
  // buildScene = 后台监视器用的单屏渲染，输出必须与前台同一份代码，
  // 这样「后台看到的」天然等于「前台渲染的」，不存在两套逻辑漂移。
  window.ZLHome = {
    DEFAULT_TYPO: DEFAULT_TYPO,
    DEFAULT_HOME: DEFAULT_HOME,
    TYPE_BASE_W: TYPE_BASE_W,
    buildScene: sceneHtml,
    mergeTypo: mergeTypo,
    typoVars: typoVars,
    render: render,
    measure: measure,
    update: update,
    scrollToScene: scrollToScene,
    state: state
  };
})();
