/* ============================================
   Zhonglele Admin — 首页编辑器逻辑
   ─────────────────────────────────────────
   架构要点（改动前必读）：
   1) 字段定义驱动：所有表单项来自下方 *_FIELDS 声明，渲染与绑定共用同一份定义。
      ⚠️ 教训沿用自 cases admin：改通用控件必须同时改「渲染分支」和「绑定 handler」，
         所以这里把 clamp / 小数位 / 取值统一收敛到 clampField() 与 readControl()，
         两条路径都只调这两个函数，杜绝分叉。
   2) 预览是「画面监视器」，不是整页预览：右侧只画**选中那一屏**（视频某一帧 + 该屏文案 +
      可读性遮罩），头部/底部一概不进预览。文案层调 scrub.js 导出的 buildScene()、
      样式用同一份 scrub.css —— 前台怎么渲染，后台就怎么预览，不存在两套逻辑。
      时间轴上的红色播放头决定看哪一帧；拖区间两端时画面跟着手指走（像剪辑软件一样找帧）。
   3) 数据契约：只读写 content.json 一份文件。保存走 POST /api/zl/content（需登录 token）。
   4) 值的「继承」语义：场景级字段留空 / 为 0 表示继承全局排版，与 scrub.js 的 mergeTypo 一致。
      因此清空输入框不能写成 0 以外的兜底值，否则会把「继承」变成「硬覆盖」。
   ============================================ */
(function () {
  'use strict';

  var API = {
    check: '/api/auth/check',
    login: '/api/login',
    content: '/api/zl/content',
    upload: '/api/zl/upload'
  };
  var TOKEN_KEY = 'zl_token';
  // 监视器的逻辑视口：宽 = 前台排版的桌面基准断点（scrub.js TYPE_BASE_W），
  // 高取常见的 1280×800 桌面窗口。整块再 transform:scale 塞进右侧面板。
  var PREVIEW_W = 1280;
  var PREVIEW_H = 800;

  var HOME_DEFAULTS = (window.ZLHome && window.ZLHome.DEFAULT_HOME) || {};
  var TYPO_DEFAULTS = (window.ZLHome && window.ZLHome.DEFAULT_TYPO) || {};
  var FONTS = window.ZL_FONTS || [];

  var S = {
    content: null,
    tab: 'scene',       // scene | video | typo | site
    sceneIdx: 0,
    dirty: false,
    duration: 0,        // 视频真实时长（探测得到，优先于 content 里记录的值）
    playhead: 0,        // 监视器当前显示的时刻（秒）—— 时间轴上红色播放头的位置
    playing: false,     // 监视器是否在循环播放当前这一屏
    pvSrc: '',          // 监视器已加载的视频地址（相同则复用，避免每次改参数都重载闪一下）
    pvSceneIdx: -1,     // 监视器文案层当前显示的是哪一屏（自由拖播放头时可能≠S.sceneIdx）
    pvSceneHtml: '',    // 上次注入的文案层 HTML（一致就不重写 DOM）
    frames: null,       // 视频帧池（时间轴胶片条用），元素是已加载的 <img>
    framesSrc: '',      // 帧池对应的视频地址（换视频就重抓）
    token: '',
    uploadTarget: null  // { path, purpose, compress, kind }
  };

  function $(id) { return document.getElementById(id); }

  // ---------- 基础工具 ----------
  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function num(v, d) {
    var n = parseFloat(v);
    return isFinite(n) ? n : d;
  }
  function clamp(v, lo, hi) { return v < lo ? lo : (v > hi ? hi : v); }

  // range/number 的小数位随 step 自适应（沿用 cases admin 的规则）
  function digitsFor(step) {
    var s = Math.abs(num(step, 1));
    if (s >= 1) return 0;
    if (s >= 0.1) return 1;
    if (s >= 0.01) return 2;
    return 3;
  }
  // 数字 → 显示串（按位数四舍五入后去掉尾随 0）
  function trimNum(n, digits) {
    var s = Number(num(n, 0)).toFixed(digits);
    if (s.indexOf('.') >= 0) s = s.replace(/0+$/, '').replace(/\.$/, '');
    return s;
  }
  function fmtSec(n) { return trimNum(n, 2) + 's'; }

  // 点路径读写：'video.src' / 'loop.start' / 'dots'
  function getPath(obj, path) {
    if (!obj) return undefined;
    var parts = String(path).split('.');
    var cur = obj;
    for (var i = 0; i < parts.length; i++) {
      if (cur == null || typeof cur !== 'object') return undefined;
      cur = cur[parts[i]];
    }
    return cur;
  }
  function setPath(obj, path, val) {
    var parts = String(path).split('.');
    var cur = obj;
    for (var i = 0; i < parts.length - 1; i++) {
      if (typeof cur[parts[i]] !== 'object' || cur[parts[i]] === null) cur[parts[i]] = {};
      cur = cur[parts[i]];
    }
    cur[parts[parts.length - 1]] = val;
  }

  function toast(msg, isErr) {
    var t = $('toast');
    t.textContent = msg;
    t.className = 'toast show' + (isErr ? ' err' : '');
    clearTimeout(toast._t);
    toast._t = setTimeout(function () { t.className = 'toast'; }, 2600);
  }

  function setSaveState(text, cls) {
    var el = $('saveState');
    el.textContent = text;
    el.className = 'save-state' + (cls ? ' ' + cls : '');
  }

  function markDirty() {
    S.dirty = true;
    setSaveState('未保存', 'dirty');
  }

  // 视频时长：探测值优先，其次 content 里记录的值（离线打开后台时仍能显示时间轴）
  function duration() {
    return S.duration || num(getPath(S.content, 'home.video.duration'), 0);
  }

  // 字段的 min/max 支持 '@duration' 动态解析
  function resolveBound(v, fallback) {
    if (v === '@duration') return duration() || 60;
    return num(v, fallback);
  }

  // ---------- 字段定义 ----------
  // group: 分组标题（同 group 的连续字段渲染进同一个 fieldset）
  // inline: true → 与相邻 inline 字段并排；span: true → 独占整行
  // hint: 字段下方灰色说明
  var FONT_FIELD_INHERIT = { key: '', label: '继承全局' };

  var SCENE_FIELDS = [
    { group: '文案', groupHint: '标题与副标题支持换行，换行会原样呈现在页面上。',
      key: 'num', type: 'text', label: '序号 / 眉标', inline: true,
      hint: '如「01 · 挥手」，留空则不显示这一行' },
    { key: 'showHint', type: 'switch', label: '显示滚动提示线', inline: true,
      hint: '底部竖线落点动画，仅第一屏生效' },
    { key: 'title', type: 'textarea', label: '主标题', rows: 2, span: true },
    { key: 'sub', type: 'textarea', label: '副标题', rows: 2, span: true },

    { group: '视频区间',
      groupHint: '这一屏滚过时视频从「起点」播到「终点」。相邻两屏若不衔接（上一屏终点 ≠ 本屏起点），滚动到交界处会跳帧 —— 时间轴上的橙色条纹就是提示，点「首尾衔接」可一键消除。',
      key: 'tStart', type: 'range', label: '视频起点', min: 0, max: '@duration', step: 0.05, unit: 's', inline: true },
    { key: 'tEnd', type: 'range', label: '视频终点', min: 0, max: '@duration', step: 0.05, unit: 's', inline: true },

    { group: '这一屏的排版覆盖',
      groupHint: '留空 / 0 表示继承「全局排版」。只有需要单独调整的屏才填。',
      key: 'fontFamily', type: 'font', label: '字体', inline: true, allowInherit: true },
    { key: 'titleSize', type: 'range', label: '标题字号', min: 0, max: 160, step: 1, unit: 'px', inline: true,
      hint: '0 = 继承；桌面基准值，窄屏自动等比收缩' },
    { key: 'titleWeight', type: 'palette', label: '标题字重', inline: true,
      palette: [{ v: 0, t: '继承' }, { v: 300, t: '300' }, { v: 400, t: '400' }, { v: 600, t: '600' }, { v: 700, t: '700' }, { v: 900, t: '900' }] },
    { key: 'subSize', type: 'range', label: '副标题字号', min: 0, max: 60, step: 1, unit: 'px', inline: true },
    { key: 'numSize', type: 'range', label: '眉标字号', min: 0, max: 40, step: 1, unit: 'px', inline: true },
    { key: 'align', type: 'palette', label: '水平对齐', inline: true,
      palette: [{ v: '', t: '继承' }, { v: 'left', t: '左' }, { v: 'center', t: '居中' }, { v: 'right', t: '右' }] },
    { key: 'vAlign', type: 'palette', label: '垂直对齐', inline: true,
      palette: [{ v: '', t: '继承' }, { v: 'top', t: '上' }, { v: 'center', t: '中' }, { v: 'bottom', t: '下' }] },
    { key: 'accent', type: 'color', label: '眉标 / 强调色', inline: true },
    { key: 'ink', type: 'color', label: '标题颜色', inline: true, hint: '留空跟随主题（浅色主题深字 / 深色主题浅字）' },
    { key: 'inkSoft', type: 'color', label: '副标题颜色', inline: true },

    { group: '按钮（可选）', groupHint: '文字与链接都填了才会显示。',
      key: 'ctaText', type: 'text', label: '按钮文字', inline: true },
    { key: 'ctaHref', type: 'text', label: '按钮链接', inline: true, hint: '站内相对路径或完整 http 链接' },
    { key: 'ctaBlank', type: 'switch', label: '新标签打开', inline: true }
  ];

  var VIDEO_FIELDS = [
    { group: '视频', groupHint: '整页只用一个视频：滚到哪就播到哪。建议先用 ffmpeg 压到 20MB 以内再上传（-crf 28 -preset slow -movflags +faststart -an）。',
      key: 'video.src', type: 'media', mediaKind: 'video', label: '视频文件', span: true },
    { key: 'video.poster', type: 'media', mediaKind: 'image', label: '封面帧（可选）', span: true,
      purpose: 'poster', hint: '视频解码前显示的静态图，避免首屏黑屏' },

    { group: '首屏自动循环', groupHint: '还没下滑时循环播放开场片段，让首屏保持动态；一旦下滑就切换成滚动驱动。',
      key: 'loop.enabled', type: 'switch', label: '开启首屏循环', inline: true },
    { key: 'loop.zone', type: 'range', label: '首屏判定范围', min: 0.05, max: 1, step: 0.05, inline: true,
      hint: '滚动量小于「视口高 × 此值」都算首屏。建议 0.3~0.5：舞台总滚动距离只有「屏数 − 1」屏，' +
            '这个值给太大，头一大段滚动都会被自动循环占用、视频不跟手' },
    { key: 'loop.start', type: 'range', label: '循环起点', min: 0, max: '@duration', step: 0.05, unit: 's', inline: true },
    { key: 'loop.end', type: 'range', label: '循环终点', min: 0, max: '@duration', step: 0.05, unit: 's', inline: true },

    { group: '可读性遮罩', groupHint: '文字压在视频上时用渐变提升可读性。视频亮就用底部渐变，画面复杂可用整屏压暗。',
      key: 'fade.pos', type: 'palette', label: '遮罩位置', span: true,
      palette: [{ v: 'bottom', t: '底部渐变' }, { v: 'top', t: '顶部渐变' }, { v: 'full', t: '整屏压暗' }, { v: 'none', t: '不使用' }] },
    { key: 'fade.height', type: 'range', label: '渐变高度', min: 0, max: 100, step: 1, unit: 'vh', inline: true,
      hint: '整屏压暗模式下此项无效' },
    { key: 'fade.scrim', type: 'range', label: '压暗强度', min: 0, max: 1, step: 0.05, inline: true,
      hint: '仅「整屏压暗」生效' },

    { group: '章节导航',
      key: 'dots', type: 'switch', label: '显示右侧圆点导航', inline: true,
      hint: '两屏以上才会出现；滚到尾声区自动淡出' }
  ];

  var TYPO_FIELDS = [
    { group: '默认排版', groupHint: '所有屏的基准值。某一屏想单独调整，在该屏的「排版覆盖」里填即可。',
      key: 'fontFamily', type: 'font', label: '字体', inline: true },
    { key: 'copyMax', type: 'range', label: '文案块最大宽度', min: 320, max: 1100, step: 10, unit: 'px', inline: true },
    { key: 'titleSize', type: 'range', label: '标题字号', min: 20, max: 160, step: 1, unit: 'px', inline: true,
      hint: '桌面基准值（1280px 宽处生效），窄屏自动收缩' },
    { key: 'titleWeight', type: 'palette', label: '标题字重', inline: true,
      palette: [{ v: 300, t: '300' }, { v: 400, t: '400' }, { v: 600, t: '600' }, { v: 700, t: '700' }, { v: 900, t: '900' }] },
    { key: 'titleLineHeight', type: 'range', label: '标题行高', min: 1, max: 2, step: 0.02, inline: true },
    { key: 'titleSpacing', type: 'range', label: '标题字距', min: -0.05, max: 0.3, step: 0.005, unit: 'em', inline: true },
    { key: 'subSize', type: 'range', label: '副标题字号', min: 10, max: 60, step: 1, unit: 'px', inline: true },
    { key: 'numSize', type: 'range', label: '眉标字号', min: 9, max: 40, step: 1, unit: 'px', inline: true },
    { key: 'align', type: 'palette', label: '水平对齐', inline: true,
      palette: [{ v: 'left', t: '左' }, { v: 'center', t: '居中' }, { v: 'right', t: '右' }] },
    { key: 'vAlign', type: 'palette', label: '垂直对齐', inline: true,
      palette: [{ v: 'top', t: '上' }, { v: 'center', t: '中' }, { v: 'bottom', t: '下' }] },

    { group: '颜色', groupHint: '强调色同时作用于眉标、圆点导航与滚动提示线。标题/副标题颜色留空则跟随深浅主题。',
      key: 'accent', type: 'color', label: '强调色', inline: true },
    { key: 'ink', type: 'color', label: '标题颜色', inline: true },
    { key: 'inkSoft', type: 'color', label: '副标题颜色', inline: true }
  ];

  var SITE_FIELDS = [
    { group: '页面信息', groupHint: '浏览器标签标题、Logo 字母、导航按钮文字与底部版权。',
      key: 'site.title', type: 'text', label: '页面标题', span: true },
    { key: 'site.brandText', type: 'text', label: 'Logo 字母', inline: true, hint: '左上角方块里的字符，1–2 个字符最佳' },
    { key: 'site.contactLabel', type: 'text', label: '导航按钮文字', inline: true, hint: '点击后平滑滚到底部联系区' },
    { key: 'site.copyright', type: 'text', label: '底部版权', span: true },
    { group: '主题',
      key: 'theme', type: 'palette', label: '全站深浅色', span: true,
      palette: [{ v: 'light', t: '浅色（白底深字）' }, { v: 'dark', t: '深色（黑底浅字）' }],
      hint: '视频若是白底动画请用浅色，否则文字会看不见' }
  ];

  // ---------- 取值 / 归一 ----------
  // 当前 tab 对应的数据宿主对象。字段 key 用点路径，宿主内自行寻址。
  function scopeObj() {
    var c = S.content;
    if (!c) return null;
    switch (S.tab) {
      case 'scene': return (c.home.scenes || [])[S.sceneIdx] || null;
      case 'video': return c.home;
      case 'typo': return c.home.typography;
      case 'site': return c;
      default: return null;
    }
  }

  function currentFields() {
    switch (S.tab) {
      case 'scene': return SCENE_FIELDS;
      case 'video': return VIDEO_FIELDS;
      case 'typo': return TYPO_FIELDS;
      case 'site': return SITE_FIELDS;
      default: return [];
    }
  }

  /**
   * 把原始值收敛成该字段的合法值。**渲染与绑定两条路径都只调这个函数**，
   * 避免「表单显示一个值、写进数据另一个值」的分叉。
   */
  function clampField(f, raw) {
    if (f.type === 'range' || f.type === 'number') {
      var min = resolveBound(f.min, 0);
      var max = resolveBound(f.max, 100);
      // 空值语义：range 的下限即「未设置」。场景级字段下限是 0，正好等于「继承」。
      if (raw === '' || raw === null || raw === undefined) return min;
      var n = num(raw, min);
      if (min > max) { var t = min; min = max; max = t; }
      return clamp(n, min, max);
    }
    if (f.type === 'switch') return !!raw;
    if (f.type === 'palette') {
      // 允许的值必须在 palette 内，否则回落到第一项（防止旧数据带来非法值）
      var ok = (f.palette || []).some(function (p) { return String(p.v) === String(raw); });
      return ok ? raw : ((f.palette || [{ v: '' }])[0].v);
    }
    if (f.type === 'color') {
      var s = String(raw == null ? '' : raw).trim();
      if (!s) return '';
      return /^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(s) ? s : '';
    }
    return raw == null ? '' : raw;
  }

  /** 从 DOM 控件读回值（与 clampField 配对，保证读写同源） */
  function readControl(f, wrap) {
    switch (f.type) {
      case 'switch':
        return !!wrap.querySelector('input[type="checkbox"]').checked;
      case 'range': {
        var r = wrap.querySelector('input[type="range"]');
        return clampField(f, r.value);
      }
      case 'number':
        return clampField(f, wrap.querySelector('input').value);
      case 'color': {
        var tx = wrap.querySelector('input[type="text"]');
        return clampField(f, tx.value);
      }
      case 'font':
        return wrap.querySelector('select').value;
      case 'palette': {
        var on = wrap.querySelector('.form-swatch.on');
        return on ? on.getAttribute('data-v') : '';
      }
      case 'textarea':
        return wrap.querySelector('textarea').value;
      case 'media':
        return getPath(scopeObj(), f.key) || '';   // media 值由上传/清除流程直接写数据
      default:
        return wrap.querySelector('input').value;
    }
  }

  // ---------- 控件渲染 ----------
  function labelHtml(f, valText) {
    return '<div class="form-label">' + esc(f.label) +
           (valText != null ? '<span class="lb-val" data-lbval>' + esc(valText) + '</span>' : '') +
           '</div>';
  }
  function hintHtml(f) {
    return f.hint ? '<div class="form-hint">' + esc(f.hint) + '</div>' : '';
  }

  function fontOptionsHtml(cur, allowInherit) {
    var out = '';
    if (allowInherit) {
      out += '<option value=""' + (!cur ? ' selected' : '') + '>' + esc(FONT_FIELD_INHERIT.label) + '</option>';
    }
    FONTS.forEach(function (f) {
      out += '<option value="' + esc(f.key) + '"' + (String(cur) === f.key ? ' selected' : '') + '>' +
             esc(f.label) + '</option>';
    });
    return out;
  }

  function mediaBoxHtml(f, val) {
    var kind = f.mediaKind || 'image';
    var thumb;
    if (val) {
      thumb = kind === 'video'
        ? '<div class="media-thumb"><video src="' + esc(val) + '" muted playsinline preload="metadata"></video></div>'
        : '<div class="media-thumb"><img src="' + esc(val) + '" alt=""></div>';
    } else {
      thumb = '<div class="media-thumb empty">未设置</div>';
    }
    var meta = val
      ? '<code>' + esc(val) + '</code>' + (kind === 'video' && duration() ? '<br>时长 ' + fmtSec(duration()) : '')
      : (kind === 'video' ? '上传 mp4 / webm' : '上传 jpg / png / webp');
    return '<div class="media-box">' +
      '<div class="media-row">' + thumb +
        '<div class="media-info">' + meta + '</div>' +
        '<div class="media-ops">' +
          '<button class="btn-secondary btn-sm" type="button" data-media-act="pick">' + (val ? '替换' : '上传') + '</button>' +
          (val ? '<button class="btn-secondary btn-sm" type="button" data-media-act="clear">清除</button>' : '') +
        '</div>' +
      '</div></div>';
  }

  function controlHtml(f, val) {
    switch (f.type) {
      case 'text':
        return '<input type="text" value="' + esc(val) + '">';
      case 'textarea':
        return '<textarea rows="' + (f.rows || 3) + '">' + esc(val) + '</textarea>';
      case 'number':
        return '<input type="number" value="' + esc(val) + '" min="' + resolveBound(f.min, 0) +
               '" max="' + resolveBound(f.max, 100) + '" step="' + (f.step || 1) + '">';
      case 'range': {
        var d = digitsFor(f.step);
        return '<div class="range-wrap">' +
            '<input type="range" min="' + resolveBound(f.min, 0) + '" max="' + resolveBound(f.max, 100) +
              '" step="' + (f.step || 1) + '" value="' + val + '">' +
            '<input type="number" class="range-num" min="' + resolveBound(f.min, 0) + '" max="' + resolveBound(f.max, 100) +
              '" step="' + (f.step || 1) + '" value="' + trimNum(val, d) + '">' +
          '</div>';
      }
      case 'switch':
        return '<label class="switch"><input type="checkbox"' + (val ? ' checked' : '') + '><i></i>' +
               '<span>' + (val ? '开启' : '关闭') + '</span></label>';
      case 'palette':
        return '<div class="form-palette">' + (f.palette || []).map(function (p) {
          var on = String(p.v) === String(val);
          var dot = p.bg ? '<span class="sw-dot" style="background:' + esc(p.bg) + '"></span>' : '';
          return '<button class="form-swatch' + (on ? ' on' : '') + '" type="button" data-v="' + esc(p.v) + '">' +
                 dot + '<span>' + esc(p.t) + '</span></button>';
        }).join('') + '</div>';
      case 'color': {
        var hex = /^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(String(val)) ? val : '#000000';
        return '<div class="color-row">' +
            '<input type="color" value="' + esc(hex) + '">' +
            '<input type="text" value="' + esc(val) + '" placeholder="留空 = 跟随主题" spellcheck="false">' +
            (val ? '<button class="btn-icon" type="button" data-color-clear title="清空">✕</button>' : '') +
          '</div>';
      }
      case 'font':
        return '<select>' + fontOptionsHtml(val, f.allowInherit) + '</select>';
      case 'media':
        return mediaBoxHtml(f, val);
      default:
        return '<input type="text" value="' + esc(val) + '">';
    }
  }

  // range 的当前值显示在 label 右上角（带单位）
  function rangeLabelText(f, val) {
    if (f.type !== 'range') return null;
    return trimNum(val, digitsFor(f.step)) + (f.unit || '');
  }

  function fieldHtml(f, host) {
    var raw = getPath(host, f.key);
    if (raw === undefined) raw = f.type === 'switch' ? false : (f.type === 'range' ? resolveBound(f.min, 0) : '');
    var val = clampField(f, raw);
    var cls = 'field' + (f.span ? ' span-all' : '');
    return '<div class="' + cls + '" data-fkey="' + esc(f.key) + '" data-ftype="' + f.type + '">' +
      labelHtml(f, rangeLabelText(f, val)) +
      controlHtml(f, val) +
      hintHtml(f) +
    '</div>';
  }

  /** 按 group 切分成若干 fieldset，inline 字段两列排布 */
  function renderFields(fields, host) {
    var html = '';
    var open = false;
    var buf = [];

    function flushGrid() {
      if (!buf.length) return;
      html += '<div class="field-grid" style="--cols:2">' + buf.join('') + '</div>';
      buf = [];
    }
    fields.forEach(function (f) {
      if (f.group) {
        flushGrid();
        if (open) html += '</fieldset>';
        html += '<fieldset class="fieldset"><legend>' + esc(f.group) + '</legend>' +
                (f.groupHint ? '<div class="fs-hint">' + esc(f.groupHint) + '</div>' : '');
        open = true;
      }
      buf.push(fieldHtml(f, host));
    });
    flushGrid();
    if (open) html += '</fieldset>';
    return html;
  }

  // ---------- 面板 ----------
  var TAB_META = {
    scene: { title: '第 N 屏', desc: '这一屏滚过时的文案与视频区间。左侧可增删排序，时间轴可直接拖拽区间两端。' },
    video: { title: '视频与遮罩', desc: '整页共用一个视频，滚动位置驱动播放进度；遮罩用于保证文字在画面上可读。' },
    typo: { title: '全局排版', desc: '所有屏的基准字体、字号与颜色。单屏想不一样，去那一屏的「排版覆盖」里填。' },
    site: { title: '页面信息', desc: '标签标题、Logo 字母、版权与全站深浅主题。' }
  };

  function renderForm() {
    var pane = $('paneForm');
    var host = scopeObj();
    if (!S.content) { pane.innerHTML = ''; return; }

    if (S.tab === 'scene' && !host) {
      pane.innerHTML = '<div class="form-head"><h2>还没有场景</h2></div>' +
        '<div class="form-desc">左侧点「＋ 添加一屏」开始配置首页的第一屏。</div>';
      return;
    }

    var meta = TAB_META[S.tab] || { title: '', desc: '' };
    var title = S.tab === 'scene' ? ('第 ' + (S.sceneIdx + 1) + ' 屏') : meta.title;
    var extra = '';
    if (S.tab === 'scene') {
      var sc = host;
      extra = '视频 ' + fmtSec(num(sc.tStart, 0)) + ' → ' + fmtSec(num(sc.tEnd, 0));
    }
    pane.innerHTML =
      '<div class="form-head"><h2>' + esc(title) + '</h2><span>' + esc(extra) + '</span></div>' +
      '<div class="form-desc">' + esc(meta.desc) + '</div>' +
      renderFields(currentFields(), host);
  }

  function renderSceneList() {
    var box = $('sceneList');
    var scenes = (S.content && S.content.home.scenes) || [];
    if (!scenes.length) {
      box.innerHTML = '<div class="scene-meta" style="padding:8px 10px">暂无场景</div>';
      return;
    }
    box.innerHTML = scenes.map(function (s, i) {
      var name = s.title ? String(s.title).split(/\r?\n/)[0] : (s.num || '未命名');
      var on = (S.tab === 'scene' && i === S.sceneIdx);
      return '<div class="scene-item' + (on ? ' on' : '') + '" data-scene="' + i + '">' +
          '<span class="scene-idx">' + (i + 1) + '</span>' +
          '<div class="scene-body">' +
            '<div class="scene-name">' + esc(name) + '</div>' +
            '<div class="scene-meta">' + fmtSec(num(s.tStart, 0)) + ' → ' + fmtSec(num(s.tEnd, 0)) + '</div>' +
          '</div>' +
          '<div class="scene-ops">' +
            '<button class="btn-icon" type="button" data-sc-act="up" data-i="' + i + '" title="上移"' + (i === 0 ? ' disabled' : '') + '>↑</button>' +
            '<button class="btn-icon" type="button" data-sc-act="down" data-i="' + i + '" title="下移"' + (i === scenes.length - 1 ? ' disabled' : '') + '>↓</button>' +
            '<button class="btn-icon danger" type="button" data-sc-act="del" data-i="' + i + '" title="删除">✕</button>' +
          '</div>' +
        '</div>';
    }).join('');

    document.querySelectorAll('.nav-tab').forEach(function (b) {
      b.classList.toggle('on', S.tab === b.getAttribute('data-tab'));
    });
  }

  // ---------- 时间轴 ----------
  function renderTimeline() {
    var track = $('tlTrack');
    var ruler = $('tlRuler');
    var dur = duration();
    var scenes = (S.content && S.content.home.scenes) || [];
    $('tlDur').textContent = dur ? ('总时长 ' + fmtSec(dur) + ' · ' + scenes.length + ' 屏') : '未设置视频';

    var inner = $('tlInner');
    if (!dur || !scenes.length) {
      track.classList.add('is-empty');
      inner.innerHTML = '<div class="tl-empty-msg">' +
        (dur ? '还没有场景，左侧添加一屏' : '先在「视频与遮罩」里上传视频') + '</div>';
      ruler.innerHTML = '';
      return;
    }
    track.classList.remove('is-empty');
    var home = S.content.home;

    // 首屏自动循环区间：视频开头这一段是"自动循环播放"的，标出来免得被当成空档
    var loopBand = '';
    if (home.loop && home.loop.enabled !== false) {
      var la = clamp(num(home.loop.start, 0), 0, dur);
      var lb = clamp(num(home.loop.end, 0), 0, dur);
      if (lb - la > 0.01) {
        loopBand = '<div class="tl-loop" style="left:' + (la / dur * 100).toFixed(3) + '%;width:' +
                   ((lb - la) / dur * 100).toFixed(3) + '%" title="首屏自动循环 ' +
                   fmtSec(la) + ' → ' + fmtSec(lb) + '"></div>';
      }
    }

    // 空隙：相邻两屏之间未被覆盖的时间（滚动到交界会跳帧）
    var gaps = '';
    for (var i = 0; i < scenes.length - 1; i++) {
      var a = num(scenes[i].tEnd, 0);
      var b = num(scenes[i + 1].tStart, 0);
      if (b - a > 0.01) {
        gaps += '<div class="tl-gap" style="left:' + (a / dur * 100).toFixed(3) + '%;width:' +
                ((b - a) / dur * 100).toFixed(3) + '%"></div>';
      }
    }

    inner.innerHTML = loopBand + scenes.map(function (s, i) {
      var a = clamp(num(s.tStart, 0), 0, dur);
      var b = clamp(num(s.tEnd, a), a, dur);
      var left = a / dur * 100;
      var w = Math.max((b - a) / dur * 100, 0.6);
      var on = (S.tab === 'scene' && i === S.sceneIdx);
      return '<div class="tl-seg' + (on ? ' on' : '') + '" data-i="' + i + '"' +
             ' style="left:' + left.toFixed(3) + '%;width:' + w.toFixed(3) + '%"' +
             ' title="第 ' + (i + 1) + ' 屏 ' + fmtSec(a) + ' → ' + fmtSec(b) + '">' +
               '<span class="tl-handle l" data-side="l"></span>' +
               '<span>' + (i + 1) + '</span>' +
               '<span class="tl-handle r" data-side="r"></span>' +
             '</div>';
    }).join('') + gaps +
      // 播放头：右侧监视器停在哪一帧就看它。拖动它 = 逐帧看画面
      '<div class="tl-play" id="tlPlay" title="拖动查看该时刻的画面"></div>';
    renderPlayhead();

    // 刻度：按总时长选一个整齐的步长，最多约 10 个
    var step = dur <= 6 ? 1 : dur <= 15 ? 2 : dur <= 40 ? 5 : dur <= 90 ? 10 : 30;
    var ticks = '';
    for (var t = 0; t <= dur + 0.001; t += step) {
      ticks += '<span class="tl-tick" style="left:' + (t / dur * 100).toFixed(3) + '%">' + trimNum(t, 1) + 's</span>';
    }
    ruler.innerHTML = ticks;
  }

  // ---------- 时间轴胶片层（整段视频的帧）----------
  // 一进后台就把整段视频等距抽成一小池帧（160×100 jpeg），沿时间轴铺成一条胶片 ——
  // 于是「时间轴上的画面」与「该时刻实际会出现的画面」严格对应（帧池等距 = 时间等距）。
  // 为什么抽帧池而不是按需抓帧：改区间/拖播放头会高频重绘，按需抓帧要不停 seek，卡；
  // 帧池只在「换视频」时抓一次，之后画布重绘是纯内存操作。
  var POOL_W = 160, POOL_H = 100, POOL_MAX = 32;

  /** 把帧池按时间等距铺满整条轨道 */
  function drawFilm() {
    var cv = $('tlFilm');
    var imgs = S.frames;
    if (!cv || !imgs || !imgs.length) return;
    var w = Math.round(cv.clientWidth), h = Math.round(cv.clientHeight);
    if (!w || !h) return;
    if (cv.width !== w || cv.height !== h) { cv.width = w; cv.height = h; }
    var ctx = cv.getContext('2d');
    ctx.clearRect(0, 0, w, h);
    var tileW = Math.max(24, Math.round(h * POOL_W / POOL_H));   // 每格按缩略图比例
    var n = Math.ceil(w / tileW);
    for (var i = 0; i < n; i++) {
      // 与时间轴同一线性映射：第 i 格 ≈ 第 (i+0.5)/n 个时刻
      var k = Math.round((i + 0.5) / n * (imgs.length - 1));
      var im = imgs[k];
      if (!im || !im.complete || !im.naturalWidth) continue;
      var x = i * tileW;
      // 逐格裁切填满（cover），与前台 object-fit:cover 同一取向
      var sc = Math.max(tileW / im.naturalWidth, h / im.naturalHeight);
      var dw = im.naturalWidth * sc, dh = im.naturalHeight * sc;
      ctx.drawImage(im, x + (tileW - dw) / 2, (h - dh) / 2, dw, dh);
      if (i > 0) { ctx.fillStyle = 'rgba(0,0,0,0.5)'; ctx.fillRect(x - 1, 0, 2, h); }
    }
    // 整条压暗一层：区间色块与编号要能压得住画面
    ctx.fillStyle = 'rgba(0,0,0,0.22)';
    ctx.fillRect(0, 0, w, h);
  }

  /** 用隐藏探测器（#probeVideo，与时间轴共用同一个视频源）抽帧 */
  function captureFrames() {
    var v = $('probeVideo');
    var src = (S.content && S.content.home.video.src) || '';
    var dur = S.duration || 0;
    if (!v || !src || !dur) return;
    if (v.readyState < 2) {   // 元信息有了但还没解码数据 → 等 loadeddata 再抓
      v.addEventListener('loadeddata', captureFrames, { once: true });
      return;
    }
    if (src !== S.framesSrc) {
      S.frames = null;        // 换视频了：旧帧池作废，先把胶片层清空
      S.framesSrc = src;
      drawFilm();
    } else if (S.frames) {
      return;                 // 同一支视频，已经抓过
    }

    var n = clamp(Math.round(dur), 12, POOL_MAX);
    var pool = new Array(n);
    var i = 0;
    var done = false;
    v.onseeked = function () { draw(); };

    function finish() {
      if (done) return;
      done = true;
      v.onseeked = null;
      // 转成 <img> 后画布才能同步 drawImage（dataURL 数组没法直接画）
      S.frames = pool.map(function (url) {
        var im = new Image();
        if (url) { im.onload = drawFilm; im.src = url; }
        return im;
      });
      drawFilm();
    }
    function draw() {
      if (done) return;
      if (i >= n) { finish(); return; }
      try {
        var c = document.createElement('canvas');
        c.width = POOL_W; c.height = POOL_H;
        var ctx = c.getContext('2d');
        // 前台是 object-fit:cover 铺满一屏，缩略图同样按 cover 画，观感一致
        var vw = v.videoWidth || 16, vh = v.videoHeight || 9;
        var k = Math.max(POOL_W / vw, POOL_H / vh);
        ctx.drawImage(v, (POOL_W - vw * k) / 2, (POOL_H - vh * k) / 2, vw * k, vh * k);
        pool[i] = c.toDataURL('image/jpeg', 0.62);
      } catch (_) { pool[i] = ''; }
      i++;
      step();
    }
    function step() {
      if (done) return;
      if (i >= n) { finish(); return; }
      var t = (i / (n - 1)) * Math.max(0, dur - 0.05);
      if (Math.abs(v.currentTime - t) < 0.005) { draw(); return; }   // 已在目标位置就不会再有 seeked
      try { v.currentTime = t; } catch (_) { finish(); }
    }
    step();
  }

  /** 一次拖拽的收尾都挂在 window 上：指针滑出轨道/元素被重建也不会丢事件 */
  function dragLoop(move, up) {
    function onUp(ev) {
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', onUp);
      window.removeEventListener('pointercancel', onUp);
      up(ev);
    }
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', onUp);
    window.addEventListener('pointercancel', onUp);
  }

  /** 指针位置 → 视频时刻（秒） */
  function trackTimeAt(ev, track, dur) {
    var rect = track.getBoundingClientRect();
    return clamp((ev.clientX - rect.left) / rect.width, 0, 1) * dur;
  }

  // 时间轴交互：① 拖轨道 = 拖播放头看画面（松手落到该帧所属那一屏）
  //             ② 拖区间两端 = 改起止秒数，画面同步跟到手指所在的那一帧
  // ⚠️ 拖拽期间只改被拖元素的内联 style，不重建 DOM ——
  //    重建会销毁正在捕获指针的节点，导致拖到一半失手。
  function bindTimeline() {
    var track = $('tlTrack');
    track.addEventListener('pointerdown', function (e) {
      var dur = duration();
      if (!dur) return;
      var handle = e.target.closest ? e.target.closest('.tl-handle') : null;
      var seg = e.target.closest ? e.target.closest('.tl-seg') : null;
      var i = seg ? parseInt(seg.getAttribute('data-i'), 10) : -1;
      e.preventDefault();
      pvPause();

      if (handle && seg && !isNaN(i)) {
        var side = handle.getAttribute('data-side');
        // 拖的是哪一屏的手柄就先选中哪一屏；⚠️ 不抢 tab —— 用户可能正在「视频与遮罩」里
        // 调首屏循环区间，顺手拖一下手柄不该把表单切走。
        S.sceneIdx = i;
        renderSceneList();
        if (S.tab === 'scene') renderForm();
        // renderTimeline() 会重建轨道 DOM，旧引用变孤儿 → 下面重取
        renderTimeline();
        var seg2 = track.querySelector('.tl-seg[data-i="' + i + '"]');
        if (seg2) handleDrag(e, track, seg2, i, dur, side);
        return;
      }

      // 其余位置（含播放头本身）都是"拖播放头看画面"
      scrubDrag(e, track, dur);
    });

    // 宽度变了要按新宽度重铺胶片（帧池不用重抓，只是分格数变了）
    var filmTick = false;
    window.addEventListener('resize', function () {
      if (filmTick) return;
      filmTick = true;
      requestAnimationFrame(function () { filmTick = false; drawFilm(); });
    });
  }

  /** 选中态落到某一屏：更新左栏高亮；只有人在「这一屏」表单里才重画表单（不抢 tab） */
  function landOnScene(i, t) {
    S.sceneIdx = i;
    S.playhead = num(t, S.playhead);
    renderSceneList();
    if (S.tab === 'scene') renderForm();
    renderTimeline();
    syncMonitor({ sceneIdx: i, keepPlayhead: true });
  }

  /**
   * 拖播放头：逐帧看画面。
   * 松手时 —— 拖过一段（看画面）= 只落到该帧所属那一屏，不抢当前 tab；
   *            点了一下 = 明确选中那一屏，左栏表单跟着切过去。
   */
  function scrubDrag(e, track, dur) {
    var free = trackTimeAt(e, track, dur);
    var moved = false;
    var x0 = e.clientX;

    function move(ev) {
      if (!moved && Math.abs(ev.clientX - x0) < 4) return;   // 抖动阈值，避免误判成拖拽
      moved = true;
      free = trackTimeAt(ev, track, dur);
      var idx = sceneIdxAt(free);
      if (idx >= 0) setPvScene(idx);        // 文案层跟着播放头走，但先不动表单
      seek(free, true);
    }
    function up() {
      seek(free, true);
      var idx = sceneIdxAt(free);
      if (idx < 0) { syncMonitor({ keepPlayhead: true }); return; }
      // 点一下（没拖动）= 明确选中那一屏；但只有本来就在「这一屏」表单里才走完整切换，
      // 否则只"落到"那一屏 —— 免得在「视频与遮罩」调首屏循环时点一下就被抢走表单。
      // （要主动切到某一屏编辑，用左栏场景列表点它，那里永远会切。）
      if (!moved && S.tab === 'scene') selectScene(idx, free);
      else landOnScene(idx, free);
    }
    dragLoop(move, up);
  }

  /** 拖区间两端：改的是起止秒数，画面同步跟到刚定下的这一端（找首帧/尾帧） */
  function handleDrag(e0, track, seg, i, dur, side) {
    var sc = S.content.home.scenes[i];
    if (!sc) return;
    function move(ev) {
      var t = Math.round(trackTimeAt(ev, track, dur) * 20) / 20;   // 对齐到 0.05s
      if (side === 'l') sc.tStart = clamp(t, 0, num(sc.tEnd, dur));
      else sc.tEnd = clamp(t, num(sc.tStart, 0), dur);
      var a = num(sc.tStart, 0);
      var b = num(sc.tEnd, a);
      seg.style.left = (a / dur * 100).toFixed(3) + '%';
      seg.style.width = Math.max((b - a) / dur * 100, 0.6).toFixed(3) + '%';
      seg.title = '第 ' + (i + 1) + ' 屏 ' + fmtSec(a) + ' → ' + fmtSec(b);
      syncRangeInputs(['tStart', 'tEnd']);
      setPvScene(i);
      seek(side === 'l' ? a : b, true);
      markDirty();
    }
    function up() {
      landOnScene(i, null);   // null = 保留当前播放头（就停在刚定下的这一端）
    }
    move(e0);           // 按下即定位，单击手柄也能立刻看到首/尾帧
    dragLoop(move, up);
  }

  /** 只更新表单里指定 key 的 range 显示值（拖时间轴时用，避免整表重绘丢焦点） */
  function syncRangeInputs(keys) {
    if (S.tab !== 'scene') return;
    var host = scopeObj();
    if (!host) return;
    keys.forEach(function (k) {
      var wrap = document.querySelector('.field[data-fkey="' + k + '"]');
      if (!wrap) return;
      var f = SCENE_FIELDS.filter(function (x) { return x.key === k; })[0];
      if (!f) return;
      var v = clampField(f, getPath(host, k));
      var r = wrap.querySelector('input[type="range"]');
      var n = wrap.querySelector('.range-num');
      var lb = wrap.querySelector('[data-lbval]');
      if (r) r.value = v;
      if (n) n.value = trimNum(v, digitsFor(f.step));
      if (lb) lb.textContent = rangeLabelText(f, v);
    });
    var headSpan = document.querySelector('.form-head span');
    if (headSpan) {
      headSpan.textContent = '视频 ' + fmtSec(num(host.tStart, 0)) + ' → ' + fmtSec(num(host.tEnd, 0));
    }
  }

  // ---------- 表单事件（统一委托，所有类型共用一条写回路径） ----------
  function fieldDefOf(key) {
    var list = currentFields();
    for (var i = 0; i < list.length; i++) if (list[i].key === key) return list[i];
    return null;
  }

  function commitField(wrap) {
    var key = wrap.getAttribute('data-fkey');
    var f = fieldDefOf(key);
    var host = scopeObj();
    if (!f || !host) return;
    var val = readControl(f, wrap);
    setPath(host, key, val);

    // 联动刷新：range 的角标 / switch 的文字 / 色板的选中态在各自 handler 里已处理，
    // 这里只补跨区域联动。
    if (f.type === 'range') {
      var lb = wrap.querySelector('[data-lbval]');
      if (lb) lb.textContent = rangeLabelText(f, val);
    }
    if (S.tab === 'scene' && (key === 'tStart' || key === 'tEnd')) {
      renderTimeline();
      renderSceneList();
      var headSpan = document.querySelector('.form-head span');
      if (headSpan) headSpan.textContent = '视频 ' + fmtSec(num(host.tStart, 0)) + ' → ' + fmtSec(num(host.tEnd, 0));
      // 画面跟到刚改的那一端（与拖时间轴手柄同一种手感：边调边看帧）
      seek(num(host[key], 0), true);
    }
    if (S.tab === 'scene' && (key === 'title' || key === 'num')) renderSceneList();
    if (S.tab === 'site' && key === 'theme') syncThemeBtn();
    if (S.tab === 'video' && (key === 'loop.start' || key === 'loop.end')) { /* 无需额外联动 */ }

    markDirty();
    syncMonitor();
  }

  function bindForm() {
    var pane = $('paneForm');

    // input：文本 / textarea / range 滑块 / 数字框 / 颜色选择器
    pane.addEventListener('input', function (e) {
      var wrap = e.target.closest ? e.target.closest('.field') : null;
      if (!wrap) return;
      var type = wrap.getAttribute('data-ftype');

      if (type === 'range') {
        var f = fieldDefOf(wrap.getAttribute('data-fkey'));
        var r = wrap.querySelector('input[type="range"]');
        var n = wrap.querySelector('.range-num');
        // 滑块与数字框互相同步（都经 clampField，保证越界输入被收敛）
        if (e.target === n) {
          var v = clampField(f, n.value);
          r.value = v;
        } else {
          n.value = trimNum(clampField(f, r.value), digitsFor(f.step));
        }
      }
      if (type === 'color') {
        var picker = wrap.querySelector('input[type="color"]');
        var text = wrap.querySelector('input[type="text"]');
        if (e.target === picker) text.value = picker.value;
        else if (/^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(text.value)) picker.value = text.value;
      }
      commitField(wrap);
    });

    // change：select / checkbox / 数字框失焦
    pane.addEventListener('change', function (e) {
      var wrap = e.target.closest ? e.target.closest('.field') : null;
      if (!wrap) return;
      if (wrap.getAttribute('data-ftype') === 'switch') {
        var on = wrap.querySelector('input[type="checkbox"]').checked;
        var txt = wrap.querySelector('.switch span');
        if (txt) txt.textContent = on ? '开启' : '关闭';
      }
      commitField(wrap);
    });

    // click：色板点选 / 颜色清空 / 媒体上传
    pane.addEventListener('click', function (e) {
      var wrap = e.target.closest ? e.target.closest('.field') : null;
      if (!wrap) return;

      var sw = e.target.closest('.form-swatch');
      if (sw) {
        wrap.querySelectorAll('.form-swatch').forEach(function (b) { b.classList.remove('on'); });
        sw.classList.add('on');
        commitField(wrap);
        return;
      }
      if (e.target.closest('[data-color-clear]')) {
        wrap.querySelector('input[type="text"]').value = '';
        commitField(wrap);
        renderForm();   // 清空后「✕」按钮要消失，整块重绘最简单
        return;
      }
      var act = e.target.closest('[data-media-act]');
      if (act) {
        var f = fieldDefOf(wrap.getAttribute('data-fkey'));
        if (!f) return;
        if (act.getAttribute('data-media-act') === 'clear') {
          setPath(scopeObj(), f.key, '');
          if (f.mediaKind === 'video') {
            setPath(S.content, 'home.video.duration', 0);
            S.duration = 0;
          }
          markDirty();
          renderForm();
          renderTimeline();
          syncMonitor();
        } else {
          pickFile(f);
        }
      }
    });
  }

  // ---------- 场景增删排序 ----------
  function newScene() {
    var scenes = S.content.home.scenes;
    var dur = duration();
    var last = scenes[scenes.length - 1];
    var a = last ? num(last.tEnd, 0) : 0;
    var b = dur ? Math.min(dur, a + Math.max(1, (dur - a) / 2)) : a + 2;
    return {
      id: 's' + Date.now().toString(36),
      tStart: a, tEnd: b,
      num: '', title: '新的一屏', sub: '',
      showHint: false,
      align: '', vAlign: '', fontFamily: '',
      titleSize: 0, titleWeight: 0, subSize: 0, numSize: 0,
      accent: '', ink: '', inkSoft: '',
      ctaText: '', ctaHref: '', ctaBlank: false
    };
  }

  /**
   * 选中某一屏：左栏表单、时间轴高亮、右侧监视器三者同步切过去。
   * @param {number} [keepT] 保留这个播放头时刻（不传则落到该屏起点）
   */
  function selectScene(i, keepT) {
    S.tab = 'scene';
    S.sceneIdx = i;
    var r = sceneRange(i);
    S.playhead = (keepT == null) ? (r ? r.a : 0) : num(keepT, 0);
    renderSceneList();
    renderForm();
    renderTimeline();
    syncMonitor({ sceneIdx: i, keepPlayhead: true });
  }

  function bindSceneList() {
    $('sceneList').addEventListener('click', function (e) {
      var opBtn = e.target.closest ? e.target.closest('[data-sc-act]') : null;
      if (opBtn) {
        e.stopPropagation();
        var i = parseInt(opBtn.getAttribute('data-i'), 10);
        var act = opBtn.getAttribute('data-sc-act');
        var scenes = S.content.home.scenes;
        if (act === 'del') {
          if (!confirm('删除第 ' + (i + 1) + ' 屏？此操作在保存后生效。')) return;
          scenes.splice(i, 1);
          S.sceneIdx = clamp(S.sceneIdx, 0, Math.max(0, scenes.length - 1));
        } else if (act === 'up' && i > 0) {
          scenes.splice(i - 1, 0, scenes.splice(i, 1)[0]);
          if (S.sceneIdx === i) S.sceneIdx = i - 1;
          else if (S.sceneIdx === i - 1) S.sceneIdx = i;
        } else if (act === 'down' && i < scenes.length - 1) {
          scenes.splice(i + 1, 0, scenes.splice(i, 1)[0]);
          if (S.sceneIdx === i) S.sceneIdx = i + 1;
          else if (S.sceneIdx === i + 1) S.sceneIdx = i;
        }
        markDirty();
        renderSceneList();
        renderForm();
        renderTimeline();
        syncMonitor();
        return;
      }
      var item = e.target.closest ? e.target.closest('[data-scene]') : null;
      if (item) selectScene(parseInt(item.getAttribute('data-scene'), 10));
    });

    $('btnAddScene').addEventListener('click', function () {
      S.content.home.scenes.push(newScene());
      S.sceneIdx = S.content.home.scenes.length - 1;
      S.tab = 'scene';
      markDirty();
      renderSceneList();
      renderForm();
      renderTimeline();
      syncMonitor();
    });

    document.querySelectorAll('.nav-tab').forEach(function (b) {
      b.addEventListener('click', function () {
        S.tab = b.getAttribute('data-tab');
        renderSceneList();
        renderForm();
        renderTimeline();
        syncMonitor();
      });
    });
  }

  // ---------- 时间轴便捷操作 ----------
  function bindTimelineTools() {
    $('btnSplitEven').addEventListener('click', function () {
      var dur = duration();
      var scenes = S.content.home.scenes;
      if (!dur || !scenes.length) { toast('先上传视频并添加场景', true); return; }
      var seg = dur / scenes.length;
      scenes.forEach(function (s, i) {
        s.tStart = Math.round(i * seg * 20) / 20;
        s.tEnd = Math.round((i + 1) * seg * 20) / 20;
      });
      scenes[scenes.length - 1].tEnd = dur;
      markDirty();
      renderTimeline();
      renderSceneList();
      renderForm();
      syncMonitor();
      toast('已按 ' + scenes.length + ' 屏均分 ' + fmtSec(dur));
    });

    $('btnChain').addEventListener('click', function () {
      var scenes = S.content.home.scenes;
      if (scenes.length < 2) { toast('至少两屏才需要衔接', true); return; }
      for (var i = 0; i < scenes.length - 1; i++) {
        scenes[i].tEnd = num(scenes[i + 1].tStart, num(scenes[i].tEnd, 0));
      }
      markDirty();
      renderTimeline();
      renderSceneList();
      renderForm();
      syncMonitor();
      toast('已消除段间空隙');
    });
  }

  // ---------- 媒体上传 ----------
  function pickFile(f) {
    S.uploadTarget = f;
    var picker = $('filePicker');
    picker.accept = f.mediaKind === 'video' ? 'video/*' : 'image/*';
    picker.value = '';
    picker.click();
  }

  function fileToBase64(file) {
    return new Promise(function (resolve, reject) {
      var fr = new FileReader();
      fr.onload = function () {
        var s = String(fr.result || '');
        var comma = s.indexOf(',');
        resolve(comma >= 0 ? s.slice(comma + 1) : s);
      };
      fr.onerror = function () { reject(new Error('读取文件失败')); };
      fr.readAsDataURL(file);
    });
  }

  function bindUpload() {
    $('filePicker').addEventListener('change', function (e) {
      var file = e.target.files && e.target.files[0];
      var f = S.uploadTarget;
      if (!file || !f) return;
      var ext = (file.name.split('.').pop() || '').toLowerCase();
      var isVideo = f.mediaKind === 'video';
      if (isVideo && ['mp4', 'webm', 'mov', 'm4v', 'ogv', 'ogg'].indexOf(ext) < 0) {
        toast('视频请用 mp4 / webm', true); return;
      }
      if (!isVideo && ['jpg', 'jpeg', 'png', 'webp', 'gif', 'avif'].indexOf(ext) < 0) {
        toast('图片请用 jpg / png / webp', true); return;
      }
      var mb = file.size / 1024 / 1024;
      if (isVideo && mb > 40) {
        if (!confirm('这个视频有 ' + mb.toFixed(1) + 'MB，首屏加载会比较慢。\n建议先用 ffmpeg 压缩：\n' +
                     'ffmpeg -i in.mp4 -c:v libx264 -crf 28 -preset slow -pix_fmt yuv420p -movflags +faststart -an out.mp4\n\n仍要继续上传？')) return;
      }
      setSaveState('上传中…', 'dirty');
      fileToBase64(file).then(function (b64) {
        var body = { ext: ext, dataBase64: b64 };
        if (f.purpose) body.purpose = f.purpose;
        if (f.compress) body.compress = f.compress;
        return fetch(API.upload, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + S.token },
          body: JSON.stringify(body)
        });
      }).then(function (r) { return r.json(); }).then(function (d) {
        if (!d || d.status !== 'ok' || !d.url) throw new Error((d && d.message) || '上传失败');
        setPath(scopeObj(), f.key, d.url);
        markDirty();
        if (isVideo) probeDuration(d.url);
        renderForm();
        syncMonitor();
        toast('上传成功');
      }).catch(function (err) {
        setSaveState('上传失败', 'err');
        toast(err.message || '上传失败', true);
      });
    });
  }

  /** 探测视频真实时长 → 回填 home.video.duration，时间轴与所有秒数字段的上限都依赖它 */
  function probeDuration(src) {
    if (!src) return;
    var v = $('probeVideo');
    v.onloadedmetadata = function () {
      var d = isFinite(v.duration) ? Math.round(v.duration * 100) / 100 : 0;
      if (!d) return;
      S.duration = d;
      setPath(S.content, 'home.video.duration', d);
      // 旧配置里超出新视频时长的区间统一收敛，避免 seek 到无效位置
      (S.content.home.scenes || []).forEach(function (s) {
        s.tStart = clamp(num(s.tStart, 0), 0, d);
        s.tEnd = clamp(num(s.tEnd, s.tStart), num(s.tStart, 0), d);
      });
      renderTimeline();
      renderSceneList();
      renderForm();
      syncMonitor();
      captureFrames();      // 时间轴缩略图（帧池，后台常驻抽一次）
    };
    v.onerror = function () { toast('视频元信息读取失败，时间轴上限用配置里的时长', true); };
    v.src = src;
    v.load();
  }

  // ---------- 画面预览（监视器）----------
  // 只画「选中那一屏」：视频某一帧 + 该屏文案 + 可读性遮罩，不含头部/底部。
  // 文案层调 scrub.js 导出的 buildScene()、样式用同一份 scrub.css ——
  // 所见即所得由「同一份渲染代码」保证，而不是靠两套代码对齐。
  var ZLH = window.ZLHome || {};

  /** 某屏的视频区间（秒）；tEnd 缺失或早于 tStart 时按同点处理 */
  function sceneRange(i) {
    var scenes = (S.content && S.content.home.scenes) || [];
    var sc = scenes[i];
    if (!sc) return null;
    var a = num(sc.tStart, 0);
    return { i: i, sc: sc, a: a, b: Math.max(a, num(sc.tEnd, a)) };
  }

  /** 某一时刻落在哪一屏（对齐前台 update() 的 seg = floor(p*n)：取最后一个覆盖它的区间） */
  function sceneIdxAt(t) {
    var scenes = (S.content && S.content.home.scenes) || [];
    var best = -1;
    for (var i = 0; i < scenes.length; i++) {
      if (t >= num(scenes[i].tStart, 0) - 1e-6) best = i;
    }
    return best;
  }

  /** 把播放头收进当前这一屏的区间（换屏时用；本来就在区间里则原地不动） */
  function clampPlayhead() {
    var r = sceneRange(S.sceneIdx);
    if (!r) { S.playhead = 0; return; }
    if (!(S.playhead >= r.a - 1e-6 && S.playhead <= r.b + 1e-6)) S.playhead = r.a;
  }

  /** 定位画面到第 t 秒 */
  function seek(t, force) {
    S.playhead = Math.max(0, num(t, 0));
    var v = $('pvVideo');
    if (v && S.pvSrc && v.readyState >= 1) {
      if (force === true || Math.abs(v.currentTime - S.playhead) > 0.01) {
        try { v.currentTime = S.playhead; } catch (_) {}
      }
    }
    renderPlayhead();
    updatePvNote();
  }

  /** 注入某一屏的文案层（HTML 没变就不动 DOM，避免每次改参数都重建节点） */
  function setPvScene(i) {
    var host = $('pvScenes');
    var scenes = (S.content && S.content.home.scenes) || [];
    var sc = scenes[i];
    S.pvSceneIdx = sc ? i : -1;
    if (!host) return;
    if (!sc || typeof ZLH.buildScene !== 'function') {
      if (S.pvSceneHtml) { host.innerHTML = ''; S.pvSceneHtml = ''; }
      return;
    }
    var html = ZLH.buildScene(sc, i, S.content.home.typography);
    if (html === S.pvSceneHtml) return;
    S.pvSceneHtml = html;
    host.innerHTML = html;
  }

  function updatePvNote() {
    var el = $('pvNote');
    if (!el || !S.content) return;
    if (!S.content.home.video.src) { el.textContent = '未设置视频'; return; }
    var r = sceneRange(S.pvSceneIdx >= 0 ? S.pvSceneIdx : S.sceneIdx);
    var total = (S.content.home.scenes || []).length;
    var head = r ? ('第 ' + (r.i + 1) + '/' + total + ' 屏 ' + fmtSec(r.a) + '→' + fmtSec(r.b))
                 : '这一屏还没设区间';
    el.textContent = head + ' · 画面 ' + fmtSec(S.playhead);
  }

  /** 播放头位置。只改 style 不重建 DOM —— 播放时每帧都要调 */
  function renderPlayhead() {
    var el = $('tlPlay');
    if (!el) return;
    var dur = duration();
    el.style.left = (dur ? clamp(S.playhead / dur, 0, 1) * 100 : 0).toFixed(3) + '%';
  }

  function syncPlayBtn() {
    var b = $('pvPlay');
    if (b) b.textContent = S.playing ? '⏸ 暂停' : '▶ 播放本屏';
  }

  function pvPause() {
    if (!S.playing) return;
    S.playing = false;
    var v = $('pvVideo');
    if (v && !v.paused) { try { v.pause(); } catch (_) {} }
    syncPlayBtn();
  }

  /** 播放循环：只在"当前这一屏"的区间里来回放，方便判断运动节奏 */
  function pvTick() {
    if (!S.playing) return;
    var v = $('pvVideo');
    if (!v) { pvPause(); return; }
    var r = sceneRange(S.pvSceneIdx);
    if (r && v.currentTime >= r.b - 0.02) { try { v.currentTime = r.a; } catch (_) {} }
    S.playhead = v.currentTime;
    renderPlayhead();
    updatePvNote();
    requestAnimationFrame(pvTick);
  }

  function pvPlayToggle() {
    if (!S.content || !S.content.home.video.src) { toast('先在「视频与遮罩」里上传视频', true); return; }
    if (S.playing) { pvPause(); return; }
    var v = $('pvVideo');
    var r = sceneRange(S.pvSceneIdx);
    if (r && (S.playhead < r.a - 1e-6 || S.playhead > r.b - 0.05)) seek(r.a, true);
    S.playing = true;
    syncPlayBtn();
    var p = v.play();
    if (p && p.catch) p.catch(function () { S.playing = false; syncPlayBtn(); });
    requestAnimationFrame(pvTick);
  }

  /**
   * 把后台数据同步到监视器 —— 所有参数变更都走这里（相当于前台的 render()）。
   * @param {object} [opts]
   *   opts.sceneIdx     文案层显示哪一屏（默认 = 当前选中的那一屏）
   *   opts.keepPlayhead 不动播放头（拖区间两端时用，否则会被 clamp 回屏首）
   */
  function syncMonitor(opts) {
    opts = opts || {};
    var stage = $('pvStage');
    var v = $('pvVideo');
    if (!stage || !v || !S.content) return;
    var home = S.content.home;

    // 监视器按站点主题出海（后台本身永远是浅色，两者独立）
    stage.setAttribute('data-theme', S.content.theme === 'dark' ? 'dark' : 'light');
    if (home.typography && home.typography.accent) {
      stage.style.setProperty('--zl-accent', home.typography.accent);
    }

    // 视频源：只在地址变了才重载，否则每敲一个字都会把画面重置回 0 秒
    var src = home.video.src || '';
    if (src !== S.pvSrc) {
      S.pvSrc = src;
      if (src) v.setAttribute('src', src);
      else v.removeAttribute('src');
      try { v.load(); } catch (_) {}
    }
    stage.classList.toggle('is-novideo', !src);

    // 可读性遮罩：与前台 render() 同一套 data-pos / height / scrim 语义。
    // ⚠️ 高度必须用 px —— 监视器是固定 800px 的逻辑视口，vh 会跟着后台窗口高度跑偏。
    var fade = $('pvFade');
    fade.setAttribute('data-pos', home.fade.pos || 'bottom');
    fade.style.height = (clamp(num(home.fade.height, 46), 0, 100) / 100 * PREVIEW_H) + 'px';
    fade.style.setProperty('--zl-scrim', clamp(num(home.fade.scrim, 0.35), 0, 1));

    setPvScene(opts.sceneIdx != null ? opts.sceneIdx : S.sceneIdx);
    if (opts.keepPlayhead !== true) clampPlayhead();
    seek(S.playhead);
  }

  function fitPreview() {
    var body = $('pvBody');
    var stage = $('pvStage');
    if (!body || !stage) return;
    var w = body.clientWidth, h = body.clientHeight;
    if (!w || !h) return;
    var scale = Math.min(w / PREVIEW_W, h / PREVIEW_H);
    stage.style.transform = 'scale(' + scale.toFixed(4) + ')';
    stage.style.left = Math.max(0, (w - PREVIEW_W * scale) / 2) + 'px';
    stage.style.top = Math.max(0, (h - PREVIEW_H * scale) / 2) + 'px';
    var s = $('pvScale');
    if (s) s.textContent = PREVIEW_W + '×' + PREVIEW_H + ' · ' + Math.round(scale * 100) + '%';
  }

  function bindPreview() {
    var v = $('pvVideo');
    // 元信息迟到时补一次定位（刚进后台、或刚上传完视频的情况）
    v.addEventListener('loadedmetadata', function () { seek(S.playhead, true); });
    v.addEventListener('error', function () {
      if (S.pvSrc) toast('预览视频加载失败，检查 uploads 里的文件是否还在', true);
    });
    v.addEventListener('ended', pvPause);
    $('pvPlay').addEventListener('click', pvPlayToggle);

    if (window.ResizeObserver) {
      new ResizeObserver(fitPreview).observe($('pvBody'));
    } else {
      window.addEventListener('resize', fitPreview);
    }
    fitPreview();

    $('btnPreviewToggle').addEventListener('click', function () {
      $('panePreview').classList.toggle('force-show');
      setTimeout(fitPreview, 60);
    });
    $('btnOpenSite').addEventListener('click', function () {
      window.open('index.html', '_blank');
    });
    // 切到别的标签页就停，别在后台空转（回来也不自动续播）
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) pvPause();
    });
  }

  // ---------- 主题 ----------
  function syncThemeBtn() {
    var t = (S.content && S.content.theme === 'dark') ? 'dark' : 'light';
    $('btnTheme').textContent = t === 'dark' ? '深色' : '浅色';
  }
  function bindTheme() {
    $('btnTheme').addEventListener('click', function () {
      S.content.theme = (S.content.theme === 'dark') ? 'light' : 'dark';
      syncThemeBtn();
      markDirty();
      if (S.tab === 'site') renderForm();
      syncMonitor();
    });
  }

  // ---------- 保存 / 加载 ----------
  function normalizeContent(raw) {
    var c = (raw && typeof raw === 'object') ? raw : {};
    if (c.theme !== 'dark' && c.theme !== 'light') c.theme = 'light';
    if (!c.site || typeof c.site !== 'object') c.site = {};
    if (!c.home || typeof c.home !== 'object') c.home = {};
    var h = c.home;
    h.video = Object.assign({ src: '', poster: '', duration: 0 }, h.video || {});
    h.loop = Object.assign({ enabled: true, start: 0, end: 1.6, zone: 0.5 }, h.loop || {});
    h.fade = Object.assign({ pos: 'bottom', height: 46, scrim: 0.35 }, h.fade || {});
    if (typeof h.dots !== 'boolean') h.dots = true;
    h.typography = Object.assign({}, TYPO_DEFAULTS, h.typography || {});
    if (!Array.isArray(h.scenes)) h.scenes = [];
    h.scenes.forEach(function (s, i) {
      if (!s.id) s.id = 's' + (i + 1);
      s.tStart = num(s.tStart, 0);
      s.tEnd = num(s.tEnd, s.tStart);
    });
    return c;
  }

  function loadContent() {
    var headers = S.token ? { 'Authorization': 'Bearer ' + S.token } : {};
    return fetch(API.content + '?t=' + Date.now(), { headers: headers, cache: 'no-store' })
      .then(function (r) { if (!r.ok) throw new Error('api'); return r.json(); })
      .catch(function () {
        // 无后端（纯静态打开后台）时回退直读静态文件，至少能查看配置
        return fetch('content.json?t=' + Date.now(), { cache: 'no-store' })
          .then(function (r) { return r.ok ? r.json() : {}; })
          .catch(function () { return {}; });
      });
  }

  function save() {
    if (!S.content) return;
    setSaveState('保存中…', 'dirty');
    fetch(API.content, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + S.token },
      body: JSON.stringify(S.content)
    }).then(function (r) {
      if (r.status === 401) throw new Error('登录已过期，请重新登录');
      return r.json();
    }).then(function (d) {
      if (!d || d.status !== 'ok') throw new Error((d && d.message) || '保存失败');
      S.dirty = false;
      setSaveState('已保存', 'ok');
      toast('已保存到 content.json');
    }).catch(function (err) {
      setSaveState('保存失败', 'err');
      toast(err.message || '保存失败', true);
      if (/登录/.test(err.message || '')) showLogin();
    });
  }

  // ---------- 登录 ----------
  function showLogin() {
    $('loginMask').hidden = false;
    $('loginUser').focus();
  }
  function hideLogin() { $('loginMask').hidden = true; }

  function bindLogin() {
    $('loginForm').addEventListener('submit', function (e) {
      e.preventDefault();
      var user = $('loginUser').value.trim();
      var pass = $('loginPass').value;
      $('loginErr').textContent = '';
      fetch(API.login, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ user: user, pass: pass, remember: true })
      }).then(function (r) { return r.json(); }).then(function (d) {
        if (!d || d.status !== 'ok' || !d.token) throw new Error((d && d.message) || '登录失败');
        S.token = d.token;
        try { localStorage.setItem(TOKEN_KEY, d.token); } catch (_) {}
        hideLogin();
        boot();
      }).catch(function (err) {
        $('loginErr').textContent = err.message || '登录失败';
      });
    });
  }

  // ---------- 启动 ----------
  var booted = false;
  function boot() {
    loadContent().then(function (raw) {
      S.content = normalizeContent(raw);
      S.duration = num(getPath(S.content, 'home.video.duration'), 0);
      if (S.content.home.video.src) probeDuration(S.content.home.video.src);

      if (!booted) {
        booted = true;
        bindForm();
        bindSceneList();
        bindTimeline();
        bindTimelineTools();
        bindUpload();
        bindPreview();
        bindTheme();
        $('btnSave').addEventListener('click', save);
        document.addEventListener('keydown', function (e) {
          if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') { e.preventDefault(); save(); }
        });
        window.addEventListener('beforeunload', function (e) {
          if (!S.dirty) return;
          e.preventDefault();
          e.returnValue = '有未保存的修改，确定离开？';
          return e.returnValue;
        });
      }
      syncThemeBtn();
      renderSceneList();
      renderForm();
      renderTimeline();
      S.dirty = false;
      setSaveState('已就绪');
      syncMonitor();
    });
  }

  function start() {
    bindLogin();
    try { S.token = localStorage.getItem(TOKEN_KEY) || ''; } catch (_) { S.token = ''; }
    if (!S.token) { showLogin(); return; }
    fetch(API.check, { headers: { 'Authorization': 'Bearer ' + S.token } })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d && d.ok) boot();
        else showLogin();
      })
      .catch(function () {
        // 后端不可用：允许只读浏览（保存会失败并提示），比直接卡住更友好
        toast('未连到本地服务，当前为只读预览', true);
        boot();
      });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
})();
